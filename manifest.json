{
  "manifest_version": 3,
  "name": "Crunchyroll Random Anime",
  "version": "1.0",
  "description": "Adds a random anime button to the top navigation bar.",
  "content_scripts": [
    {
      "matches": ["*://*.crunchyroll.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/randomimg.png"],
      "matches": ["*://*.crunchyroll.com/*"]
    }
  ]
}